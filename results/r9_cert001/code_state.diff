+    l_gap: float = 0.0,
+) -> torch.Tensor:
+    """CPU variant of :func:`_sample_policy_efforts` (large-M NVML workaround).
+
+    The policy forward pass stays on the agent's device (a single state row);
+    only the Beta parameters are moved to CPU, where the M samples are drawn
+    under a seeded CPU fork_rng. Deterministic per (seed); used only when the
+    caller evaluates with M > 16384.
+
+    Returns a FLAT (M,) tensor — unlike the GPU sampler's (M,1) — so payoff
+    arithmetic stays elementwise (linear memory) instead of broadcasting to
+    an (M,M) matrix.
+    """
+    low, high = effort_bounds
+    state = agent.state_from_params(q=float(q), k=k, w_h=w_h, w_l=w_l, l_gap=l_gap)
+    with torch.no_grad():
+        dist, _ = agent.dist(state)
+        cpu_dist = torch.distributions.Beta(
+            dist.concentration1.detach().cpu(), dist.concentration0.detach().cpu()
+        )
+        with torch.random.fork_rng(devices=[]):
+            torch.manual_seed(int(seed))
+            samples = cpu_dist.sample((M,))
+        samples = samples.reshape(-1).clamp(0.0, 1.0)
+    return low + samples * (high - low)
